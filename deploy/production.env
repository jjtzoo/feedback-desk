# Non-secret deployment settings for production (spec v3 D25, D29, D30). Secrets live in Secret
# Manager as feedback-production-*; never put them here. Values marked REPLACE come from Chris (ask 1, 9).
DEPLOY_ENV=production
DEPLOY_BRANCH=main
PROJECT_ID=REPLACE-gcp-project-id
REGION=australia-southeast1
AR_REPO=feedback
API_SERVICE=feedback-api-production
WEB_SERVICE=feedback-web-production
WORKER_JOB=feedback-worker-production
SCHEDULER_JOB=feedback-worker-production
CLOUDSQL_INSTANCE=REPLACE-gcp-project-id:australia-southeast1:REPLACE-instance
GCS_BUCKET=redadair-feedback-production-files
API_SA=feedback-api-production@REPLACE-gcp-project-id.iam.gserviceaccount.com
WEB_SA=feedback-web-production@REPLACE-gcp-project-id.iam.gserviceaccount.com
WORKER_SA=feedback-worker-production@REPLACE-gcp-project-id.iam.gserviceaccount.com
SCHEDULER_SA=feedback-scheduler-production@REPLACE-gcp-project-id.iam.gserviceaccount.com
APP_BASE_URL=https://feedback.redadair.com.au
ALLOWED_DOMAINS=redadair.com.au
GOOGLE_OAUTH_CLIENT_ID=REPLACE-oauth-client-id.apps.googleusercontent.com
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.zeptomail.com.au
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=emailapikey
MAIL_FROM=Feedback <noreply@redadair.com.au>
GMAIL_SENDER=
