# Feedback local settings. Copy to .env (git-ignored). Non-secret values only (spec v3 D13, D19):
# staging and production read secrets from Secret Manager and their settings from deploy/<env>.env.
# Local development uses staging-like configuration and never production resources (D25).

# local | test | staging | production
APP_ENV=local

# Postgres for Docker Compose. Compose builds DATABASE_URL from these for the api and worker.
POSTGRES_DB=feedback
POSTGRES_USER=feedback
POSTGRES_PASSWORD=local-only-password
# Used when running the backend outside Docker (uv run ...).
DATABASE_URL=postgresql+asyncpg://feedback:local-only-password@localhost:5432/feedback

# Signs session state and file links. Any long random string locally.
SECRET_KEY=local-only-secret-change-me

# Public address of the web app; used in links and the Google sign-in redirect.
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# --- Sign-in (D1, D23) ---------------------------------------------------------------------
# Only these Google Workspace domains may sign in. redadair.example is for the seeded
# placeholder people and is only accepted locally.
ALLOWED_DOMAINS=redadair.com.au,redadair.example
# The development-only sign-in picker, while the Google OAuth client is pending (ask 2).
DEV_LOGIN=true
# Google OAuth client id (not secret). The client secret comes from Secret Manager.
GOOGLE_OAUTH_CLIENT_ID=

# --- Model (D8) ------------------------------------------------------------------------------
# auto = Vertex AI if GOOGLE_GENAI_USE_ENTERPRISE=true, else Gemini API if a key is available,
# else the scripted stub model (local and test only).
MODEL_PROVIDER=auto
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Spend guards (D36): 0 switches a limit off. Reached = new chats go to the backup form.
DAILY_TOKENS_PER_USER=150000
DAILY_BUDGET_AUD=5
MONTHLY_BUDGET_AUD=60
# Vertex AI on Google Cloud (alternative to an AI Studio key):
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=australia-southeast1
# The AI Studio key is a secret (D19): never paste it into this file. To use Gemini locally,
# load it into the shell session from Secret Manager before starting the API:
#   PowerShell: $env:GOOGLE_API_KEY = gcloud secrets versions access latest --secret=feedback-staging-google-api-key
#   Bash:       export GOOGLE_API_KEY="$(gcloud secrets versions access latest --secret=feedback-staging-google-api-key)"
# Host folder with gcloud's application_default_credentials.json (Windows: %APPDATA%/gcloud).
GCLOUD_CONFIG_DIR=./.gcloud-empty

# --- Files (D10) -------------------------------------------------------------------------------
STORAGE_BACKEND=local
GCS_BUCKET=

# --- Email (D18, D32) ----------------------------------------------------------------------------
# smtp = Mailpit locally (host mailpit in Compose, localhost outside it); off = no email.
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
MAIL_FROM=Feedback <noreply@redadair.example>
GMAIL_SENDER=

# --- Scheduled jobs ----------------------------------------------------------------------------
# Token for /api/jobs/* (any value locally; Secret Manager in the cloud).
JOB_TOKEN=local-job-token
TIMEZONE=Australia/Sydney
